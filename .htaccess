# Hostinger (Apache/LiteSpeed): serve only the files the site loads. Everything else in the checkout 404s:
# .git, tests/, docs/REDESIGN.md, package.json, the Tailwind sources, unused themes, folder listings.
# When the site starts loading a new file, add its path to the allow rule below.
Options -Indexes
DirectoryIndex index.html

# No <IfModule> guard on purpose: without mod_rewrite this fails closed (500) instead of exposing everything
RewriteEngine On
# Patterns are relative to this file's folder, so the same file works in public_html and in public_html/about
RewriteRule ^js/themes/(agent|aiplayground)\.js$ - [R=404,L]
# Agents that ask for Markdown get the home page as index.md (built by scripts/build-seo.js)
RewriteCond %{HTTP_ACCEPT} text/markdown
RewriteRule ^(index\.html)?$ index.md [L]
RewriteRule ^(index\.(html|md)|robots\.txt|sitemap\.xml|llms\.txt|styles\.css|css/tailwind\.css|js/(content|caricature|main)\.js|js/themes/[a-z]+\.js|images/(favicon|apple-touch-icon)\.png|images/profile\.jpg|docs/Ashutosh_Pandey_Resume\.pdf)?$ - [L]
RewriteRule ^ - [R=404,L]

AddType text/markdown .md
AddCharset utf-8 .md .txt
# Code and pages are rechecked on every visit (a 304 when unchanged); LiteSpeed's default kept them 7 days, so a
# deploy didn't reach returning visitors. Images and the PDF keep the default.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|md|js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
# Home page: point agents at llms.txt and the Markdown version; caches must key on Accept (HTML vs Markdown)
<IfModule mod_headers.c>
    <FilesMatch "^index\.(html|md)$">
        Header set Link "<llms.txt>; rel=\"describedby\"; type=\"text/plain\", <index.md>; rel=\"alternate\"; type=\"text/markdown\""
        Header merge Vary Accept
    </FilesMatch>
</IfModule>
